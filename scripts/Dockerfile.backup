# Prism Backup Container
# PostgreSQL client + rclone for off-site sync

# The client major must be at least the deployment's server major: pg_dump
# refuses to dump a newer server, so a 15 client against the deployed
# PostgreSQL 18 aborted every nightly backup and every rollout's production
# snapshot. Bump this together with the server pin in home-infra's
# stacks/prism/compose.yml.
FROM postgres:18-alpine

# rclone for cloud storage sync; curl for healthcheck pings
RUN apk add --no-cache rclone curl

# Copy scripts
COPY backup.sh /scripts/backup.sh
COPY backup-scheduler.sh /scripts/backup-scheduler.sh
COPY restore.sh /scripts/restore.sh

# Fix Windows line endings and make executable
RUN sed -i 's/\r$//' /scripts/*.sh && chmod +x /scripts/*.sh

ENTRYPOINT ["/bin/sh", "/scripts/backup-scheduler.sh"]
